# Copy to testing/.env and fill in. The scripts source testing/.env if it
# exists; its values take precedence over the environment.

# The Safe under test. Replaces the placeholder Safe in every test transaction,
# and its first two owners replace the receiver placeholders.
SAFE_ADDRESS=

# Chain ID of the Safe: 1 (Ethereum Mainnet), 100 (Gnosis Chain) or
# 42161 (Arbitrum One).
CHAIN_ID=100

# API key for api.safe.global, used to read the Safe's nonce and owners from
# the Safe Transaction Service. See https://developer.safe.global.
SAFE_API_KEY=

# Optional: the nonce of the proposed transactions. Defaults to the Safe's
# current nonce. The owners are still read from the Safe Transaction Service.
#SAFE_NONCE=
