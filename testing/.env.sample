# Copy to testing/.env and fill in. The scripts source testing/.env if it
# exists; its values take precedence over the environment.

# The Safe under test. Replaces the placeholder Safe in every test transaction,
# and its first two owners replace the receiver placeholders. It is read on the
# chain of each test transaction, so it must exist on every chain tested.
SAFE_ADDRESS=

# Optional: API key for api.safe.global, used to read the Safe's nonce and
# owners from the Safe Transaction Service. Without it, the API allows 1
# request per minute, which is enough to test one chain per script run. See
# https://developer.safe.global.
#SAFE_API_KEY=

# Optional: the nonce of the proposed transactions, on every chain. Defaults to
# the Safe's current nonce on the chain of each transaction. The owners are still read from the Safe Transaction Service.
#SAFE_NONCE=

# propose-safenet.sh: the full URL of the Safenet relayer's transaction
# endpoint (e.g. https://<proxy>/tx), the same value as the explorer's
# "Relayer Url" setting.
SAFENET_RELAYER_URL=

# propose-safenet.sh, optional: the Safenet explorer base URL used for the
# printed links.
#SAFENET_EXPLORER_URL=https://safenet-explorer.eth.limo
