# Arbitration Safe App build config. Copy to `.env` to override; unset variables fall back to these defaults
# (the experimental deployment on Gnosis mainnet, see `src/config/oracle.ts`).

# Chain the SentinelOracle is deployed on. The app refuses to load requests from a Safe on any other chain.
VITE_CHAIN_ID=100
# SentinelOracle whose FROZEN (disputed) requests are listed.
VITE_SENTINEL_ORACLE_ADDRESS=0x544F12bAd6FF72564abBc7eA6494A2a4BdD0DDD0
# Inclusive lower bound for event discovery. Required when selecting another oracle or chain.
VITE_SENTINEL_ORACLE_DEPLOYMENT_BLOCK=48280806
# Maximum blocks per log query. History loads automatically, then only new ranges are polled.
VITE_LOG_BLOCK_RANGE=10000
